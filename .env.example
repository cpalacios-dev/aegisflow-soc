# ==============================================================================
# CONFIGURACIÓN DE APIS PRINCIPALES (REQUERIDAS)
# ==============================================================================

# Clave de OpenAI para la ejecución de los agentes y el supervisor
OPENAI_API_KEY=your_openai_api_key_here

# Clave de Tavily para búsquedas web en tiempo real sobre inteligencia de amenazas
TAVILY_API_KEY=your_tavily_api_key_here

# Clave de VirusTotal para el análisis automático de IOCs (IPs, URLs, Hashes)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here


# ==============================================================================
# CONFIGURACIÓN DE GMAIL (INTEGRACIÓN GOOGLE WORKSPACE)
# ==============================================================================

# Ruta al archivo JSON de credenciales OAuth2 descargado de Google Cloud Console
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# Ruta donde se almacenará el token de acceso una vez autenticado el flujo
GMAIL_TOKEN=token.json


# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA SOC (NOTIFICACIONES Y PUERTOS)
# ==============================================================================

# Destinatario predeterminado para las alertas críticas validadas por el SOC
SOC_EMAIL_RECIPIENT=engineer.education.colab@gmail.com

# Remitente o alias desde el cual se enviarán los correos (opcional)
SOC_EMAIL_SENDER=soc-alertas@tuempresa.com

# Configuración de puertos de la infraestructura local
WEBHOOK_PORT=8000
DASHBOARD_PORT=8501